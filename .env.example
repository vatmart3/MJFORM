# Variables à définir dans Vercel (Settings → Environment Variables).
# Adresse de l'atelier, affichée sur /merci et dans Stripe (page de paiement, facture).
# Vide : « Sète · l’adresse exacte vous est envoyée par SMS la veille ».
ADRESSE_ATELIER=

# Clé secrète Stripe (sk_live_... en production, sk_test_... pour les essais)
STRIPE_SECRET_KEY=sk_test_...

# Un prix Stripe (price_...) par atelier, en EUR, au montant exact affiché sur le site.
# Le paiement est refusé si le montant Stripe ne correspond pas au site.
STRIPE_PRICE_FETES=price_...
STRIPE_PRICE_IA_COMPTOIR=price_...
STRIPE_PRICE_GOOGLE_AVIS=price_...
STRIPE_PRICE_RESEAUX=price_...
STRIPE_PRICE_ZERO_PAPERASSE=price_...
STRIPE_PRICE_PACK_N1=price_...
STRIPE_PRICE_MAITRISER_CLAUDE=price_...
STRIPE_PRICE_AGENT_IA=price_...
STRIPE_PRICE_AUTOMATISER=price_...
STRIPE_PRICE_SOLUTION_SANS_CODER=price_...
STRIPE_PRICE_PACK_N2=price_...

# ——— Espace client (/espace, /admin) : Supabase + Stripe ———
# Projet Supabase DÉDIÉ à l'espace client (Project Settings → API).
# Sans ces deux variables, l'espace client tourne en mode démo (données fictives dans le navigateur).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique « anon » (lisible dans le navigateur : la sécurité repose sur le RLS)
VITE_SUPABASE_ANON_KEY=
# 1 = force le mode démo même si Supabase est configuré (ex. URL de prévisualisation)
VITE_ESPACE_DEMO=

# Côté serveur uniquement (fonctions api/espace et api/stripe-webhook), JAMAIS préfixées VITE_
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « service_role » : contourne le RLS, ne doit jamais quitter le serveur
SUPABASE_SERVICE_ROLE_KEY=

# Secret de signature du webhook Stripe (whsec_...), endpoint https://<domaine>/api/stripe-webhook
# Les formations en ligne sont facturées au prix enregistré en base : aucun STRIPE_PRICE_* à créer.
STRIPE_WEBHOOK_SECRET=whsec_...
